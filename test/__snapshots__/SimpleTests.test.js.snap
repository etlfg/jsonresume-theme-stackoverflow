  <body class="light">
    <a class="skip-to-content" href="#resume">Skip to content</a> <main id="resume" class="resume svelte-rssu9l"><!--[0--><!--[0--><header class="header clear svelte-10f9ycp"><div class="header-top svelte-10f9ycp"><div class="name-container svelte-10f9ycp"><!--[-1--> <div class="name-text svelte-10f9ycp"><h1 class="name svelte-10f9ycp">Richard Hendriks</h1> <h2 class="label svelte-10f9ycp">Programmer</h2></div></div> <div class="contact-container svelte-10f9ycp"><div class="contact-details svelte-10f9ycp"><!--[0--><div class="contact svelte-121pvxs"><!--[0--><div class="contact-item svelte-121pvxs"><span class="fa-regular fa-envelope icon svelte-121pvxs"></span> <a class="hide-href-print" href="mailto:richard.hendriks@mail.com">richard.hendriks@mail.com</a></div> <!--[0--><div class="contact-item svelte-121pvxs"><span class="fa-solid fa-mobile-screen-button icon svelte-121pvxs"></span> <a class="hide-href-print" href="tel:(912) 555-4321">(912) 555-4321</a></div> <!--[-1--></div><!----> <!--[0--><div class="contact-secondary svelte-10f9ycp"><!--[0--><span class="location svelte-10f9ycp"><!--[0--><span>2712 Broadway St,</span> <!--[0--><span>San Francisco,</span> <!--[0--><span>California</span> <!--[0--><span>(US)</span></span> <!--[-1--><!----></div></div></div></div> <!--[0--><nav class="profiles svelte-10f9ycp" aria-label="Social profiles"><!--[0--><div class="item svelte-a76edc"><div class="username"><span class="fa-brands fa-twitter social svelte-a76edc" style="--brand-light: #00aced; --brand-dark: #00aced"></span> <!--[0--><span class="url"><a target="_blank" href="https://www.twitter.com"><span class="show-only-url-print">neutralthoughts</span></a></span></div></div><!--[0--><div class="item svelte-a76edc"><div class="username"><span class="fa-brands fa-soundcloud social svelte-a76edc" style="--brand-light: #ff3a00; --brand-dark: #ff3a00"></span> <!--[0--><span class="url"><a target="_blank" href="https://soundcloud.example.com/dandymusicnl"><span class="show-only-url-print">dandymusicnl</span></a></span></div></div></nav></header> <!--[0--><section class="section svelte-1lncexq"><header class="svelte-1lncexq"><h2 class="section-title svelte-1lncexq"><!--[0--><i class="fa-solid fa-user svelte-1lncexq" aria-hidden="true"></i> Übersicht<!--[-1--></h2></header> <section class="main-summary svelte-10f9ycp"><div><!--[0--><!--161124u--><p style="margin:0">Richard hails from Tulsa. He has earned degrees from the University of Oklahoma and Stanford. (Go Sooners and Cardinal!) Before starting Pied Piper, he worked for Hooli as a part time software developer. While his work focuses on applied information theory, mostly optimizing lossless compression schema of both the length-limited and adaptive variants, his non-work interests range widely, everything from quantum computing to chaos theory. He could tell you about it, but THAT would NOT be a “length-limited” conversation!</p><!----><!----></div></section><!----></section><!--[1--><!--[0--><section class="section svelte-1lncexq"><header class="svelte-1lncexq"><h2 class="section-title svelte-1lncexq"><!--[0--><i class="fa-solid fa-gears svelte-1lncexq" aria-hidden="true"></i> Kenntnisse<!--[-1--></h2></header> <section class="skills-grid svelte-18p2gu6"><div class="skill-item svelte-18p2gu6"><!--[0--><h3 class="name svelte-18p2gu6">Web Development</h3> <!--[0--><ul class="keywords svelte-1615qzb"><li title="HTML" class="svelte-1615qzb"><span class="badge-text svelte-1615qzb">HTML</span> <!--[-1--></li><li title="CSS" class="svelte-1615qzb"><span class="badge-text svelte-1615qzb">CSS</span> <!--[-1--></li><li title="Javascript" class="svelte-1615qzb"><span class="badge-text svelte-1615qzb">Javascript</span> <!--[-1--></li></ul><!----></div><div class="skill-item svelte-18p2gu6"><!--[0--><h3 class="name svelte-18p2gu6">Compression</h3> <!--[0--><ul class="keywords svelte-1615qzb"><li title="Mpeg" class="svelte-1615qzb"><span class="badge-text svelte-1615qzb">Mpeg</span> <!--[-1--></li><li title="MP4" class="svelte-1615qzb"><span class="badge-text svelte-1615qzb">MP4</span> <!--[-1--></li><li title="GIF" class="svelte-1615qzb"><span class="badge-text svelte-1615qzb">GIF</span> <!--[-1--></li></ul><!----></div></section> <div class="legend svelte-18p2gu6"><span class="legend-title svelte-18p2gu6">Kenntnisstufen</span> <span class="legend-items svelte-18p2gu6"><span class="legend-item svelte-18p2gu6"><span class="dot newbie svelte-18p2gu6"></span> Newbie</span> <span class="legend-item svelte-18p2gu6"><span class="dot intermediate svelte-18p2gu6"></span> Mittelstufe</span> <span class="legend-item svelte-18p2gu6"><span class="dot advanced svelte-18p2gu6"></span> Fortgeschritten</span> <span class="legend-item svelte-18p2gu6"><span class="dot master svelte-18p2gu6"></span> Meister</span> <span class="legend-item svelte-18p2gu6"><span class="dot expert svelte-18p2gu6"></span> Experte</span></span></div><!----></section><!--[2--><!--[0--><section class="section svelte-1lncexq"><header class="svelte-1lncexq"><h2 class="section-title svelte-1lncexq"><!--[0--><i class="fa-solid fa-briefcase svelte-1lncexq" aria-hidden="true"></i> Berufserfahrung<!--[0--><span class="item-count svelte-1lncexq">(1)</span></h2></header> <section id="work" class="timeline-section"><section class="timeline-item svelte-g3qng"><div class="timeline-row svelte-g3qng"><div class="timeline-date svelte-g3qng"><!--[0--><div class="date-atomic svelte-1ky8w55"><!--[0--><div class="date-range svelte-1ky8w55"><span class="startDate svelte-1ky8w55">Dez. 2013</span> <!--[0--><span class="endDate svelte-1ky8w55">- Dez. 2014</span></div> <!--[0--><span class="duration-text svelte-1ky8w55">(1 Jahr)</span></div></div> <div class="timeline-connector svelte-g3qng"><span class="timeline-dot svelte-g3qng" aria-hidden="true"></span></div> <div class="timeline-card svelte-g3qng"><header class="card-header svelte-g3qng"><!--[0--><div class="position svelte-g3qng">CEO/President</div> <!--[0--><div class="company svelte-g3qng">bei  <!--[0--><a target="_blank" href="http://piedpiper.example.com" class="svelte-g3qng">Pied Piper</a></div> <!--[0--><span class="location svelte-g3qng"><span class="fa-solid fa-location-dot"></span> <!--[0-->Palo Alto, CA</span></header> <!--[-1--><!----> <!--[-1--> <div class="item svelte-g3qng"><!--[0--><div class="summary svelte-g3qng"><!--[0--><!--l05k9x--><p style="margin:0">Pied Piper is a multi-platform technology based on a proprietary universal compression algorithm that has consistently fielded high Weisman Scores™ that are not merely competitive, but approach the theoretical limit of lossless compression.</p><!----><!----></div> <!--[0--><ul class="highlights svelte-hqrtpf"><li class="svelte-hqrtpf"><!--[0--><!--1693yu--><p style="margin:0">Build an algorithm for artist to detect if their music was violating copy right infringement laws</p><!----><!----></li><li class="svelte-hqrtpf"><!--[0--><!--ky1nml--><p style="margin:0">Successfully won Techcrunch Disrupt</p><!----><!----></li><li class="svelte-hqrtpf"><!--[0--><!--apqo3d--><p style="margin:0">Optimized an algorithm that holds the current world record for Weisman Scores</p><!----><!----></li></ul><!----></div></div></div></section></section><!----></section><!--[3--><!--[0--><section class="section svelte-1lncexq"><header class="svelte-1lncexq"><h2 class="section-title svelte-1lncexq"><!--[0--><i class="fa-solid fa-rocket svelte-1lncexq" aria-hidden="true"></i> Projekte<!--[0--><span class="item-count svelte-1lncexq">(1)</span></h2></header> <section id="projects" class="timeline-section"><section class="timeline-item svelte-g3qng"><div class="timeline-row svelte-g3qng"><div class="timeline-date svelte-g3qng"><!--[0--><div class="date-atomic svelte-1ky8w55"><!--[0--><div class="date-range svelte-1ky8w55"><span class="startDate svelte-1ky8w55">Aug. 2016</span> <!--[0--><span class="endDate svelte-1ky8w55">- Aug. 2016</span></div> <!--[0--><span class="duration-text svelte-1ky8w55">(Gegenwart)</span></div></div> <div class="timeline-connector svelte-g3qng"><span class="timeline-dot svelte-g3qng" aria-hidden="true"></span></div> <div class="timeline-card svelte-g3qng"><header class="card-header svelte-g3qng"><!--[0--><div class="position svelte-g3qng">Miss Direction</div> <!--[-1--> <!--[-1--></header> <!--[0--><ul class="keywords svelte-1615qzb"><li title="GoogleMaps" class="svelte-1615qzb"><span class="badge-text svelte-1615qzb">GoogleMaps</span> <!--[-1--></li><li title="Chrome Extension" class="svelte-1615qzb"><span class="badge-text svelte-1615qzb">Chrome Extension</span> <!--[-1--></li><li title="Javascript" class="svelte-1615qzb"><span class="badge-text svelte-1615qzb">Javascript</span> <!--[-1--></li></ul><!----> <!--[0--><!--[0--><span class="website svelte-fiykfy"><span class="fa-solid fa-up-right-from-square"></span> <a target="_blank" href="http://missdirection.example.com">http://missdirection.example.com</a></span><!----> <div class="item svelte-g3qng"><!--[0--><div class="summary svelte-g3qng"><!--[0--><!--1tmgzfl--><p style="margin:0">A mapping engine that misguides you</p><!----><!----></div> <!--[0--><ul class="highlights svelte-hqrtpf"><li class="svelte-hqrtpf"><!--[0--><!--12wudep--><p style="margin:0">Won award at AIHacks 2016</p><!----><!----></li><li class="svelte-hqrtpf"><!--[0--><!--11l6yir--><p style="margin:0">Built by all women team of newbie programmers</p><!----><!----></li><li class="svelte-hqrtpf"><!--[0--><!--s6g8d--><p style="margin:0">Using modern technologies such as GoogleMaps, Chrome Extension and Javascript</p><!----><!----></li></ul><!----></div></div></div></section></section><!----></section><!--[4--><!--[0--><section class="section svelte-1lncexq"><header class="svelte-1lncexq"><h2 class="section-title svelte-1lncexq"><!--[0--><i class="fa-solid fa-hand-holding-heart svelte-1lncexq" aria-hidden="true"></i> Ehrenamtliche Tätigkeiten<!--[0--><span class="item-count svelte-1lncexq">(1)</span></h2></header> <section id="volunteer" class="timeline-section"><section class="timeline-item svelte-g3qng"><div class="timeline-row svelte-g3qng"><div class="timeline-date svelte-g3qng"><!--[0--><div class="date-atomic svelte-1ky8w55"><!--[0--><div class="date-range svelte-1ky8w55"><span class="startDate svelte-1ky8w55">Jan. 2012</span> <!--[0--><span class="endDate svelte-1ky8w55">- Jan. 2013</span></div> <!--[0--><span class="duration-text svelte-1ky8w55">(1 Jahr)</span></div></div> <div class="timeline-connector svelte-g3qng"><span class="timeline-dot svelte-g3qng" aria-hidden="true"></span></div> <div class="timeline-card svelte-g3qng"><header class="card-header svelte-g3qng"><!--[0--><div class="position svelte-g3qng">Teacher</div> <!--[0--><div class="organization svelte-g3qng">bei  <!--[0--><a target="_blank" href="http://coderdojo.example.com/" class="svelte-g3qng">CoderDojo</a></div> <!--[-1--></header> <!--[-1--><!----> <!--[-1--> <div class="item svelte-g3qng"><!--[0--><div class="summary svelte-g3qng"><!--[0--><!--j18lmw--><p style="margin:0">Global movement of free coding clubs for young people.</p><!----><!----></div> <!--[0--><ul class="highlights svelte-hqrtpf"><li class="svelte-hqrtpf"><!--[0--><!--1pp2it0--><p style="margin:0">Awarded 'Teacher of the Month'</p><!----><!----></li></ul><!----></div></div></div></section></section><!----></section><!--[5--><!--[0--><section class="section svelte-1lncexq"><header class="svelte-1lncexq"><h2 class="section-title svelte-1lncexq"><!--[0--><i class="fa-solid fa-graduation-cap svelte-1lncexq" aria-hidden="true"></i> Bildung<!--[0--><span class="item-count svelte-1lncexq">(1)</span></h2></header> <section id="education" class="timeline-section"><section class="timeline-item svelte-g3qng"><div class="timeline-row svelte-g3qng"><div class="timeline-date svelte-g3qng"><!--[0--><div class="date-atomic svelte-1ky8w55"><!--[0--><div class="date-range svelte-1ky8w55"><span class="startDate svelte-1ky8w55">Juni 2011</span> <!--[0--><span class="endDate svelte-1ky8w55">- Jan. 2014</span></div> <!--[0--><span class="duration-text svelte-1ky8w55">(2 Jahre 7 Monate)</span></div></div> <div class="timeline-connector svelte-g3qng"><span class="timeline-dot svelte-g3qng" aria-hidden="true"></span></div> <div class="timeline-card svelte-g3qng"><header class="card-header svelte-g3qng"><!--[0--><div class="position svelte-g3qng">Bachelor Information Technology</div> <!--[0--><div class="institution svelte-g3qng">bei  <!--[0--><a target="_blank" href="https://www.ou.edu/" class="svelte-g3qng">University of Oklahoma</a></div> <!--[-1--></header> <!--[-1--><!----> <!--[0--><!--[0--><!--[0--><ul class="courses svelte-1615qzb"><li title="DB1101 - Basic SQL" class="svelte-1615qzb"><span class="badge-text svelte-1615qzb">DB1101 - Basic SQL</span> <!--[-1--></li><li title="CS2011 - Java Introduction" class="svelte-1615qzb"><span class="badge-text svelte-1615qzb">CS2011 - Java Introduction</span> <!--[-1--></li></ul> <!--[-1--><!----> <div class="item svelte-g3qng"><!--[-1--> <!--[-1--><!----></div></div></div></section></section><!----></section><!--[6--><!--[0--><section class="section svelte-1lncexq"><header class="svelte-1lncexq"><h2 class="section-title svelte-1lncexq"><!--[0--><i class="fa-solid fa-trophy svelte-1lncexq" aria-hidden="true"></i> Auszeichnungen<!--[0--><span class="item-count svelte-1lncexq">(1)</span></h2></header> <section id="awards" class="timeline-section"><section class="timeline-item svelte-g3qng"><div class="timeline-row svelte-g3qng"><div class="timeline-date svelte-g3qng"><!--[1--><div class="date">Nov. 2014</div></div> <div class="timeline-connector svelte-g3qng"><span class="timeline-dot svelte-g3qng" aria-hidden="true"></span></div> <div class="timeline-card svelte-g3qng"><header class="card-header svelte-g3qng"><!--[0--><div class="position svelte-g3qng">Digital Compression Pioneer Award</div> <!--[0--><div class="awarder svelte-g3qng">bei  <!--[-1-->Techcrunch</div> <!--[-1--></header> <!--[-1--><!----> <!--[-1--> <div class="item svelte-g3qng"><!--[0--><div class="summary svelte-g3qng"><!--[0--><!--1nciraa--><p style="margin:0">There is no spoon.</p><!----><!----></div> <!--[-1--><!----></div></div></div></section></section><!----></section><!--[7--><!--[-1--><!--[8--><!--[0--><section class="section svelte-1lncexq"><header class="svelte-1lncexq"><h2 class="section-title svelte-1lncexq"><!--[0--><i class="fa-solid fa-book svelte-1lncexq" aria-hidden="true"></i> Veröffentlichungen<!--[0--><span class="item-count svelte-1lncexq">(1)</span></h2></header> <section id="publications" class="timeline-section"><section class="timeline-item svelte-g3qng"><div class="timeline-row svelte-g3qng"><div class="timeline-date svelte-g3qng"><!--[1--><div class="date">Okt. 2014</div></div> <div class="timeline-connector svelte-g3qng"><span class="timeline-dot svelte-g3qng" aria-hidden="true"></span></div> <div class="timeline-card svelte-g3qng"><header class="card-header svelte-g3qng"><!--[0--><div class="position svelte-g3qng">Video compression for 3d media</div> <!--[0--><div class="publisher svelte-g3qng">bei  <!--[-1-->Hooli</div> <!--[-1--></header> <!--[-1--><!----> <!--[-1--> <div class="item svelte-g3qng"><!--[0--><div class="summary svelte-g3qng"><!--[0--><!--1mdj26r--><p style="margin:0">Innovative middle-out compression algorithm that changes the way we store data.</p><!----><!----></div> <!--[-1--><!----></div></div></div></section></section><!----></section><!--[9--><!--[0--><section class="section svelte-1lncexq"><header class="svelte-1lncexq"><h2 class="section-title svelte-1lncexq"><!--[0--><i class="fa-solid fa-language svelte-1lncexq" aria-hidden="true"></i> Sprachkenntnisse<!--[0--><span class="item-count svelte-1lncexq">(1)</span></h2></header> <section class="languages-grid svelte-2dygc7"><div class="language-entry display svelte-2dygc7"><!--[0--><h3 class="language svelte-2dygc7">English</h3> <div class="language-item svelte-2dygc7"><!--[0--><div class="level master svelte-10tjtrd" role="meter" aria-label="Native speaker" aria-valuemin="0" aria-valuemax="100" aria-valuenow="80"><em class="svelte-10tjtrd">Native speaker</em> <div class="bar svelte-10tjtrd" aria-hidden="true"></div></div></div></div></section><!----></section><!--[10--><!--[0--><section class="section svelte-1lncexq"><header class="svelte-1lncexq"><h2 class="section-title svelte-1lncexq"><!--[0--><i class="fa-solid fa-heart svelte-1lncexq" aria-hidden="true"></i> Interessen<!--[0--><span class="item-count svelte-1lncexq">(1)</span></h2></header> <section class="interests-grid svelte-1bnc9h3"><div class="interest-item svelte-1bnc9h3"><!--[0--><h3 class="name svelte-1bnc9h3">Wildlife</h3> <!--[0--><ul class="keywords svelte-1615qzb"><li title="Ferrets" class="svelte-1615qzb"><span class="badge-text svelte-1615qzb">Ferrets</span> <!--[-1--></li><li title="Unicorns" class="svelte-1615qzb"><span class="badge-text svelte-1615qzb">Unicorns</span> <!--[-1--></li></ul><!----> <!--[-1--></div></section><!----></section><!--[11--><!--[0--><section class="section svelte-1lncexq"><header class="svelte-1lncexq"><h2 class="section-title svelte-1lncexq"><!--[0--><i class="fa-solid fa-address-card svelte-1lncexq" aria-hidden="true"></i> Empfehlungen<!--[0--><span class="item-count svelte-1lncexq">(1)</span></h2></header> <section class="references-list"><div class="reference-item svelte-1y7ope6"><!--[0--><blockquote class="reference svelte-1y7ope6">“ It is my pleasure to recommend Richard, his performance working as a consultant for Main St. Company proved that he will be a valuable addition to any company. ”</blockquote> <!--[0--><div class="name svelte-1y7ope6">Erlich Bachman</div></div></section><!----></section></main>
