  }</style><style id="svelte-1y7ope6">.reference-item.svelte-1y7ope6 {padding-left:var(--sp-3);margin-bottom:var(--sp-4);border-left:3px solid var(--color-reference-border);}.reference.svelte-1y7ope6 {font-style:italic;color:var(--color-text);line-height:var(--lh-base);margin-bottom:var(--sp-1);}.name.svelte-1y7ope6 {font-weight:700;font-size:var(--fs-meta);color:var(--color-text-secondary);}.name.svelte-1y7ope6::before {content:"— ";}</style>
