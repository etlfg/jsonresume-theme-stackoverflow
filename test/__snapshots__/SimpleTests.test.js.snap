    <link rel="stylesheet" href="./override.css">
    <style>
      /* Variables (light) */
:root {
  --color-text: #40484f; --color-text-secondary: #606d76; --color-text-muted: #757575;
  --color-heading: #202931; --color-date: #202931; --color-accent: #ff6d1f;
  --color-link: #007bff; --color-link-hover: #0056b3;
  --color-background: var(--color-section-title-bg); --color-background-alt: #f1f8ff;
  --color-border: #ccc; --color-border-light: #ddd;
  --color-keyword-text: #2c5777; --color-keyword-bg: #dfeaf1; --color-keyword-border: #dfeaf1;
  --color-reference-border: #ff6d1f;
--color-bar-newbie: #ffffff; --color-bar-intermediate: #eab308;
  --color-bar-advanced: #f97316; --color-bar-master: #059669; --color-bar-expert: #7c3aed;
  --color-level-newbie: var(--color-bar-newbie);
  --color-level-intermediate: var(--color-bar-intermediate);
  --color-level-advanced: var(--color-bar-advanced);
  --color-level-master: var(--color-bar-master);
  --color-level-expert: var(--color-bar-expert);
  --color-level-native: var(--color-bar-master);
  --color-section-title-bg: #fff;
  --header-bg: var(--color-background-alt);
  --header-border-color: var(--color-accent);
  --header-name-font-size: var(--fs-name);
  --header-name-name-font-weight: 200;
  --header-name-letter-spacing: -0.015em;
  --header-label-font-weight: 300;
  --font-family: "Helvetica Neue", Helvetica, Arial, "Lucida Grande", sans-serif;

  /* Type scale — 14px base, ~1.14 ratio (professional) */
  --fs-name: 2.4rem;       /* Increased from 2.143rem for better impact */
  --fs-label: 1.429rem;      /* 20px */
  --fs-title: 1.143rem;      /* 16px */
  --fs-card: 1.071rem;       /* 15px */
  --fs-body: 1rem;           /* 14px */
  --fs-meta: 0.929rem;       /* 13px (date, location, keywords) */
  --fs-section: 0.9rem;      /* Increased from 0.857rem */
  --fs-fine: 0.786rem;       /* 11px */

  /* Line heights — multiples of 4 against base */
  --lh-tight: 1.2;
  --lh-snug: 1.4;
  --lh-base: 1.5; /* Reverted to 1.5 for exact HTML match and tighter vertical rhythm */

  /* Spacing — 8pt grid */
  --sp-1: 0.286rem;  /*  4px */
  --sp-2: 0.571rem;  /*  8px */
  --sp-3: 0.857rem;  /* 12px */
  --sp-4: 1.143rem;  /* 16px */
--sp-5: 1.714rem;  /* Reverted to 24px */
  --sp-6: 2.286rem;  /* Reverted to 32px */
  --timeline-date-col: 132px;  /* shared date column width — aligns timeline spines across all sections; 12px headroom over widest date (108px) so dates never wrap in print */
}

/* Variables (dark) */
@media (prefers-color-scheme: dark) {
  :root {
--color-text: #d4d4d8; --color-text-secondary: #a1a1aa; --color-text-muted: #9ca3af;
    --color-heading: #e4e4e7; --color-date: #ffffff; --color-accent: #fb923c;
    --color-link: #60a5fa; --color-link-hover: #93c5fd;
    --color-background: #18181b; --color-background-alt: #27272a;
    --color-border: #3f3f46; --color-border-light: #3f3f46;
    --color-keyword-text: #93c5fd; --color-keyword-bg: #1e3a5f; --color-keyword-border: #1e3a5f;
    --color-reference-border: #fb923c;
    --color-bar-newbie: #ffffff; --color-bar-intermediate: #eab308;
    --color-bar-advanced: #f97316; --color-bar-master: #059669; --color-bar-expert: #7c3aed;
    --color-level-newbie: var(--color-bar-newbie);
    --color-level-intermediate: var(--color-bar-intermediate);
    --color-level-advanced: var(--color-bar-advanced);
    --color-level-master: var(--color-bar-master);
    --color-level-expert: var(--color-bar-expert);
    --color-level-native: var(--color-bar-master);
  --color-section-title-bg: #18181b;
  --header-bg: var(--color-background-alt);
  --header-border-color: var(--color-accent);
  --header-name-font-size: var(--fs-name);
  --header-name-name-font-weight: 200;
  --header-name-letter-spacing: -0.015em;
  --header-label-font-weight: 300;
  --font-family: "Helvetica Neue", Helvetica, Arial, "Lucida Grande", sans-serif;
  }
}

/* Minimal reset */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
img { max-width: 100%; display: block; }
a { color: inherit; text-decoration: none; }
ul, ol { list-style: none; }

/* FontAwesome CDN */
@import url('https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css');

/* Base typography */
body, html { font-family: var(--font-family); font-size: 14px; color: var(--color-text); background-color: var(--color-background); font-weight: 400; line-height: var(--lh-base); text-align: left; }
p { display: block; }
a { color: var(--color-link); text-decoration: none; }
a:hover { color: var(--color-link-hover); text-decoration: underline; }
li { list-style-type: square; list-style-position: outside; margin-left: 1.3em; margin-bottom: var(--sp-1); }
h1 { font-size: var(--fs-name); line-height: var(--lh-tight); font-weight: 700 !important; }
h2 { font-size: var(--fs-label); line-height: var(--lh-snug); }
h3 { font-size: var(--fs-card); line-height: var(--lh-snug); }
em { color: var(--color-text-muted); }
strong { font-weight: 700; }

/* Accessibility */
.skip-to-content { position: absolute; left: -9999px; top: 0; z-index: 999; padding: 0.5em 1em; background: var(--color-accent); color: #fff; font-weight: 600; text-decoration: none; }
.skip-to-content:focus { left: 0; }
.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
a:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; border-radius: 2px; }

/* Print */
@media print {
  @page { margin: 1.4cm 1.4cm; }
  body { line-height: var(--lh-snug); }
  ul { margin-top: var(--sp-2); }
  ul, li { padding: 0; }
  .timeline-item { break-inside: avoid; }

  /* Section title break-avoid — global fallback.
     Applied to the <header> element (not the h2) — Chromium only
     honors break-after: avoid-page on the header box. */
  .section > header {
    break-after: avoid-page;
  }
  .section > *:not(header) {
    break-inside: avoid;
  }
  .section-title + * {
    orphans: 3;
    widows: 3;
  }
}

@media screen and (min-width: 1025px) { li { margin-left: 1.5em; } }

/* Timeline item dates — global rules removed; now handled in TimelineItem.svelte scoped styles */

/* Timeline section: fixed date column width (--timeline-date-col) so spines align
   across all sections. Column 2 (32px) is the connector: spine center at 8px = (32px - 12px date padding) / 2
   minus a 2px visual bias toward the date (compensates the card's 4px accent border). */
.timeline-section {
  display: grid;
  grid-template-columns: var(--timeline-date-col) 32px minmax(0, 1fr);
  gap: 0;
}

@media screen and (max-width: 768px) {
  .timeline-section {
    display: block;
  }
}

