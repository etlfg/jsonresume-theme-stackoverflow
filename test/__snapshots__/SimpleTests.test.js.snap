  }

  @media screen and (min-width: 480px) and (max-width: 601px) {.languages-grid.svelte-2dygc7 {grid-template-columns:repeat(2, minmax(0, 1fr));}
  }</style><style id="svelte-10tjtrd">.level.svelte-10tjtrd {margin-bottom:0.5em;}.level.svelte-10tjtrd em:where(.svelte-10tjtrd) {padding-left:0.2em;}.level.svelte-10tjtrd .bar:where(.svelte-10tjtrd) {border:1px solid var(--color-border-light);display:block;width:10em;height:5px;position:relative;}.level.svelte-10tjtrd .bar:where(.svelte-10tjtrd)::after {position:absolute;content:" ";top:0;left:0;background:var(--color-bar-newbie, #ffffff);height:5px;}.level.newbie.svelte-10tjtrd .bar:where(.svelte-10tjtrd)::after {background:var(--color-bar-newbie, #ffffff);width:2em;border:1px solid var(--color-border-light);}.level.intermediate.svelte-10tjtrd .bar:where(.svelte-10tjtrd)::after {background:var(--color-bar-intermediate, #eab308);width:4em;}.level.advanced.svelte-10tjtrd .bar:where(.svelte-10tjtrd)::after {background:var(--color-bar-advanced, #f97316);width:6em;}.level.master.svelte-10tjtrd .bar:where(.svelte-10tjtrd)::after {background:var(--color-bar-master, #059669);width:8em;}.level.expert.svelte-10tjtrd .bar:where(.svelte-10tjtrd)::after,
  .level.native.speaker.svelte-10tjtrd .bar:where(.svelte-10tjtrd)::after {background:var(--color-bar-expert, #7c3aed);width:10em;}

  @media print {.level.svelte-10tjtrd {margin:0.5em 0;font-weight:400;}.level.svelte-10tjtrd em:where(.svelte-10tjtrd) {font-style:normal;padding:0.1em 0;}.level.svelte-10tjtrd .bar:where(.svelte-10tjtrd) {display:block !important;-webkit-print-color-adjust:exact !important;print-color-adjust:exact !important;}.level.svelte-10tjtrd .bar:where(.svelte-10tjtrd)::after {-webkit-print-color-adjust:exact !important;print-color-adjust:exact !important;}
  }</style><style id="svelte-1bnc9h3">.interests-grid.svelte-1bnc9h3 {display:grid;grid-template-columns:repeat(3, minmax(0, 1fr));column-gap:var(--sp-5);row-gap:var(--sp-3);}.interest-item.svelte-1bnc9h3 {padding:0;border-bottom:none;}.interest-item.svelte-1bnc9h3 .name:where(.svelte-1bnc9h3) {font-weight:700;font-size:var(--fs-card);line-height:var(--lh-snug);color:var(--color-heading);margin-bottom:var(--sp-1);}.summary.svelte-1bnc9h3 {font-size:var(--fs-body);line-height:var(--lh-base);color:var(--color-text);margin-top:var(--sp-1);}

  @media print {.interests-grid.svelte-1bnc9h3 {display:grid !important;grid-template-columns:repeat(3, minmax(0, 1fr)) !important;column-gap:var(--sp-5) !important;row-gap:var(--sp-3) !important;}.interest-item.svelte-1bnc9h3 {display:block !important;text-align:left !important;margin-left:0 !important;padding-left:var(--sp-4) !important;margin-bottom:var(--sp-3) !important;}.interest-item.svelte-1bnc9h3 ul {margin-left:0 !important;}.summary.svelte-1bnc9h3 {display:block !important;margin-top:var(--sp-1) !important;text-align:left !important;}
